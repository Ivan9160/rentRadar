// use prisma-8

enum ListingSource {
  GRATKA
  OTODOM
}

model Listing {
  id              Int           @id @default(autoincrement())
  externalId      String
  source          ListingSource
  title           String
  url             String

  price           Int?
  rent            Int?
  deposit         Int?

  rooms           Int?
  area            Float?

  address         String?
  isExactAddress  Boolean       @default(false)

  latitude        Float?
  longitude       Float?

  description     String?
  addedAt         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       temporal.updatedAt()

  @@unique([source, externalId])
}